node_modules
.next
*.tsbuildinfo
.git
.gitignore
.claude
.DS_Store
README.md

# Personal data stays out of the image; it's mounted at runtime instead.
.env
.env.*
data/
keys/
*.p8
*.pem

# Tailscale node state
tailscale/

# Docs and repo tooling aren't needed in the image
docs/
.github/
*.md

# The studio's server is its own image (studio/Dockerfile); this one only needs the editor's
# source (studio/src), which Next.js builds into the /studio page.
studio/*
!studio/src
