node_modules
.next
*.tsbuildinfo
.git
.gitignore
.claude
.DS_Store
README.md

# Personal data stays out of the image; it's mounted at runtime instead.
.env
.env.*
data/
keys/
*.p8
*.pem

# Tailscale node state
tailscale/

# Docs and repo tooling aren't needed in the image
docs/
.github/
*.md

# The studio's renderer is its own image (studio/Dockerfile); this one needs the editor (studio/src)
# and the data API it shares with the studio's server (studio/server/api.ts, store.ts).
studio/*
!studio/src
!studio/server
studio/server/*
!studio/server/api.ts
!studio/server/store.ts
