# Copy to .env (Docker) or .env.local (npm run dev) and fill in.
# Everything here can also be entered in the dashboard's Settings dialog instead.

# App Store Connect → Users and Access → Integrations → Team Keys.
# The key needs the "Sales" role (or Finance/Admin) for sales & subscription reports.
ASC_KEY_ID=
ASC_ISSUER_ID=
# App Store Connect → Payments and Financial Reports (top-left, under your name)
ASC_VENDOR_NUMBER=

# Put AuthKey_<KEY_ID>.p8 in ./keys/ and it is found automatically.
# Only set this if the key lives somewhere else (path as seen by the app).
# ASC_PRIVATE_KEY_PATH=

# Docker only
# PORT=3000
# Who can reach it: 127.0.0.1 (default) = this computer only; 0.0.0.0 = your whole network.
# BIND_ADDRESS=127.0.0.1
# Folder on the host that holds AuthKey_<KEY_ID>.p8 (mounted read-only).
# ASC_KEYS_DIR_HOST=./keys

# --- Sign-in ---
# true (default): a password protects the dashboard.
# false: no password at all. Only do this when BIND_ADDRESS is 127.0.0.1 (this computer)
#        or every device that can reach the port is yours.
# OPENCONNECT_PASSWORD_REQUIRED=true
# The password. Leave unset to choose one in the browser on first start
# (it asks for a one-time setup code from: docker logs openconnect).
# OPENCONNECT_PASSWORD=
# With the password off, pages are only served under local names (localhost, IPs,
# *.local, *.lan, *.ts.net, ...). List any other hostname you use here, comma-separated.
# OPENCONNECT_ALLOWED_HOSTS=dashboard.example.home

# HTTPS on your tailnet (docker-compose.tailscale.yml). Optional: without a key, log in
# once with the link from `docker logs openconnect-tailscale`.
# TS_AUTHKEY=
# TS_HOSTNAME=openconnect
