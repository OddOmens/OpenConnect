{
  "name": "openappshot",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "setup:browser": "playwright install chromium-headless-shell",
    "appshot": "node bin/appshot.mjs",
    "dev:watch": "tsx watch --exclude \"./data/**\" --exclude \"./src/**\" server/index.ts",
    "install:claude": "bash scripts/install-claude.sh",
    "install:desktop": "node scripts/install-desktop.mjs",
    "mcp": "node bin/appshot-mcp.mjs",
    "setup:emoji": "bash scripts/fetch-emoji.sh"
  },
  "description": "Local studio for building, reviewing and exporting App Store screenshots — scriptable by Claude.",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "archiver": "^8.0.0",
    "express": "^5.2.1",
    "image-size": "^2.0.4",
    "lucide-react": "^1.54.0",
    "multer": "^2.4.0",
    "nanoid": "^5.1.16",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "^4.6.6",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module",
  "bin": {
    "appshot": "bin/appshot.mjs",
    "appshot-mcp": "bin/appshot-mcp.mjs"
  }
}
