# Copy to .env next to docker-compose.yml.

# Port on the host
# PORT=4317
# Who can reach it: 127.0.0.1 (default) = this computer only; 0.0.0.0 = your whole network.
# There is no sign-in, so only use 0.0.0.0 on a network you trust (home LAN, tailnet).
# BIND_ADDRESS=127.0.0.1

# Host user and group that own ./data (`id -u`, `id -g`)
# PUID=1000
# PGID=1000

# HTTPS on your tailnet (docker-compose.tailscale.yml). Optional: without a key, log in
# once with the link from `docker logs openappshot-tailscale`.
# TS_AUTHKEY=
# TS_HOSTNAME=openappshot
